<?xml version="1.0" encoding="utf-8"?>
<extension type="plugin" group="captcha" method="upgrade">
	<name>PLG_CAPTCHA_QA</name>
	<creationDate>November 2026</creationDate>
	<author>Ron Crans</author>
	<authorEmail>ronjc@rjconline.net</authorEmail>
	<authorUrl>rjconline.net</authorUrl>
	<version>2.0.0</version>
	<updater jver="((4\.[1-8])||(5\.[0-3])||(6\.[0-4]))" pver="8.1" />
	<copyright>Copyright (C) 2013-2026 RJCreations. All rights reserved.</copyright>
	<license>GNU General Public License version 3 or later; see LICENSE.txt</license>
	<description>PLG_CAPTCHA_QA_XML_DESCRIPTION</description>
	<namespace path="src">RJCreations\Plugin\Captcha\Qa</namespace>
	<scriptfile>script.php</scriptfile>
	<files>
		<folder plugin="qa">services</folder>
		<folder>language</folder>
		<folder>layouts</folder>
		<folder>src</folder>
	</files>
	<media destination="plg_captcha_qa" folder="media">
		<folder>qalang</folder>
		<folder>css</folder>
		<folder>js</folder>
	</media>
	<config>
		<fields name="params">
			<fieldset name="basic">
				<field
					name="time_check"
					type="number"
					default="10"
					label="PLG_CAPTCHA_QA_TIME_CHECK_LABEL"
					description="PLG_CAPTCHA_QA_TIME_CHECK_DESC"
					filter="integer" />
				<field
					name="cool_down"
					type="number"
					default="300"
					label="PLG_CAPTCHA_QA_COOL_DOWN_LABEL"
					description="PLG_CAPTCHA_QA_COOL_DOWN_DESC"
					filter="integer" />
			</fieldset>
			<fieldset name="custom" label="PLG_CAPTCHA_QA_CUSTOMQAS" addfieldprefix="RJCreations\Plugin\Captcha\Qa\Field">
				<field
					name="customqa"
					type="customqas"
					default="0"
					hiddenLabel="true" />
				<field
					name="my_modal_container"
					type="modal"
					control_class="notshown" />
			</fieldset>
		</fields>
	</config>
	<updateservers>
		<server type="extension" priority="1" name="Captcha Q&amp;A Updates">https://rjcrans.net/jupdates/plg_qa/updates.php</server>
	</updateservers>
</extension>
