<?xml version="1.0" encoding="utf-8"?>
<extension type="plugin" group="captcha" method="upgrade">
	<name>PLG_CAPTCHA_QA</name>
	<creationDate>November 2026</creationDate>
	<author>Ron Crans (original); community-maintained modification</author>
	
	
	<version>2.1.1</version>
	<copyright>Copyright (C) 2013-2026 RJCreations; modifications 2026 community contributors.</copyright>
	<license>GNU General Public License version 3 or later; see LICENSE.txt</license>
	<description>PLG_CAPTCHA_QA_XML_DESCRIPTION</description>
	<namespace path="src">RJCreations\Plugin\Captcha\Qa</namespace>
	<scriptfile>script.php</scriptfile>
	<files>
		<folder plugin="qa">services</folder>
		<folder>language</folder>
		<folder>layouts</folder>
		<folder>src</folder>
	</files>
	<media destination="plg_captcha_qa" folder="media">
		<folder>qalang</folder>
		<folder>css</folder>
		<folder>js</folder>
	</media>
	<config>
		<fields name="params">
			<fieldset name="basic">
				<field
					name="time_check"
					type="number"
					default="10"
					label="PLG_CAPTCHA_QA_TIME_CHECK_LABEL"
					description="PLG_CAPTCHA_QA_TIME_CHECK_DESC"
					filter="integer" />
				<field
					name="success_cooldown"
					type="number"
					default="300"
					min="0"
					label="PLG_CAPTCHA_QA_SUCCESS_COOLDOWN_LABEL"
					description="PLG_CAPTCHA_QA_SUCCESS_COOLDOWN_DESC"
					filter="integer" />
			</fieldset>
			<fieldset name="custom" label="PLG_CAPTCHA_QA_CUSTOMQAS" addfieldprefix="RJCreations\Plugin\Captcha\Qa\Field">
				<field
					name="customqa"
					type="customqas"
					default="0"
					hiddenLabel="true" />
				<field name="my_modal_container" type="modal" control_class="notshown" />
			</fieldset>
		</fields>
	</config>
</extension>
